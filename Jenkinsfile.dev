// =====================================================
// Pipeline 2 : Build complet sur push (branche dev)
// Builds paralleles par version de Python
// =====================================================

def buildImage(String py) {
    sh """#!/bin/bash
        set -o pipefail
        docker build --build-arg PYTHON_VERSION=${py} -t ${env.IMAGE_BASE}-py${py} . 2>&1 | tee reports/build-py${py}.log
    """
}

def saveReports(String status) {
    sh """
        mkdir -p reports
        docker logs ${env.APP} > reports/app.log 2>&1 || true
        {
          echo "Pipeline : Build complet (push dev)"
          echo "Job      : ${env.JOB_NAME}"
          echo "Build    : #${env.BUILD_NUMBER}"
          echo "Branche  : ${env.BRANCH_NAME}"
          echo "Commit   : \$(git rev-parse --short HEAD 2>/dev/null || echo n/a)"
          echo "Images   : ${env.IMAGE_BASE}-py3.11 / -py3.12 / -py3.13"
          echo "Runtime  : Python ${env.RUN_PY}"
          echo "Statut   : ${status}"
          echo "Date     : \$(date '+%Y-%m-%d %H:%M:%S')"
        } > reports/pipeline-report.txt
    """
    archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true, fingerprint: true
}

pipeline {
    agent any

    options {
        skipDefaultCheckout()
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        IMAGE_BASE = "todo-api:${env.BRANCH_NAME.toLowerCase()}-${env.BUILD_NUMBER}"
        APP        = "todo-${env.BRANCH_NAME.toLowerCase()}-${env.BUILD_NUMBER}"
        NETWORK    = 'devops-net'
        RUN_PY     = '3.12'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git log -1 --oneline'
            }
        }

        stage('Setup') {
            steps {
                sh '''
                    mkdir -p reports
                    docker --version
                    echo "Branche : ${BRANCH_NAME}"
                '''
            }
        }

        stage('Build') {
            parallel {
                stage('Python 3.11') { steps { buildImage('3.11') } }
                stage('Python 3.12') { steps { buildImage('3.12') } }
                stage('Python 3.13') { steps { buildImage('3.13') } }
            }
        }

        stage('Run (Docker)') {
            steps {
                sh '''
                    docker run -d --name "$APP" --network "$NETWORK" "$IMAGE_BASE-py$RUN_PY"
                    docker ps --filter "name=$APP"
                '''
            }
        }

        stage('Smoke Test') {
            steps {
                sh 'bash smoke_test.sh "http://$APP:5000" reports/smoke-results.txt'
            }
        }

        stage('Archive Artifacts') {
            steps {
                script { saveReports('PASSED') }
            }
        }

        stage('Cleanup') {
            steps {
                sh 'docker rm -f "$APP" || true'
            }
        }
    }

    post {
        failure {
            script { saveReports('FAILED') }
        }
        cleanup {
            sh '''
                docker rm -f "$APP" || true
                for v in 3.11 3.12 3.13; do docker rmi "$IMAGE_BASE-py$v" || true; done
            '''
            cleanWs()
        }
    }
}